{
  "name": "scout-internship-copilot",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/scout-dev.mjs",
    "build": "vinext build",
    "start": "vinext start",
    "agent:start": "node --experimental-strip-types agent/server.ts",
    "agent:dev": "node --experimental-strip-types agent/server.ts",
    "test": "npm run test:unit && npm run build && node --test tests/rendered-html.test.mjs",
    "test:unit": "node --experimental-strip-types --test tests/*.test.ts",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "verify:release": "npm test && npm run lint && python tests/migration-smoke.py && npm run db:generate && git diff --exit-code && npm run build && git diff --check && git status --short --branch && git diff --stat",
    "scout:ai:status": "node --experimental-strip-types scripts/scout-ai-status.mjs",
    "scout:gmail:oauth": "node scripts/scout-gmail-oauth.mjs",
    "scout:profile:repair": "node scripts/scout-profile-repair.mjs",
    "scout:demo:status": "node scripts/scout-demo-db.mjs status",
    "scout:demo:seed": "node scripts/scout-demo-db.mjs seed",
    "scout:demo:reset": "node scripts/scout-demo-db.mjs reset"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.0",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.29",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.16",
    "wrangler": "4.126.0"
  },
  "type": "module"
}
