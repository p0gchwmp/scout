{
  "name": "scout-internship-copilot",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/scout-local-run.mjs",
    "dev:demo": "node scripts/scout-local-run.mjs --demo",
    "dev:raw": "node scripts/scout-dev.mjs",
    "doctor": "node scripts/scout-doctor.mjs",
    "smoke": "node scripts/scout-smoke.mjs",
    "build": "vinext build",
    "start": "vinext start",
    "agent:start": "node --experimental-strip-types agent/server.ts",
    "agent:dev": "node --experimental-strip-types agent/server.ts",
    "test": "npm run test:unit && npm run build && node --test tests/rendered-html.test.mjs tests/release-rehearsal.test.mjs",
    "test:unit": "node --experimental-strip-types --test tests/*.test.ts",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "check:clean": "node scripts/assert-clean-worktree.mjs",
    "verify:release": "npm test && npm run lint && python tests/migration-smoke.py && python tests/personio-migration-smoke.py && python tests/company-outreach-migration-smoke.py && npm run db:generate && git diff --exit-code && npm run check:clean && node scripts/scout-local-run.mjs --self-test && node scripts/scout-doctor.mjs --self-test && node scripts/scout-smoke.mjs --self-test && node scripts/scout-ready.mjs --self-test && node scripts/scout-smoke.mjs && npm run build && git diff --check && npm run check:clean && git status --short --branch && git diff --stat",
    "scout:ai:status": "node --experimental-strip-types scripts/scout-ai-status.mjs",
    "scout:gmail:oauth": "node scripts/scout-gmail-oauth.mjs",
    "scout:profile:repair": "node scripts/scout-profile-repair.mjs",
    "scout:lead-context": "node --experimental-strip-types scripts/scout-lead-context.ts",
    "scout:demo:status": "node scripts/scout-demo-db.mjs status",
    "scout:demo:seed": "node scripts/scout-demo-db.mjs seed",
    "scout:demo:reset": "node scripts/scout-demo-reset.mjs",
    "scout:demo:reset:all": "node scripts/scout-demo-reset-all.mjs",
    "scout:demo:workflow:status": "node --experimental-strip-types scripts/scout-demo-workflow.mjs status",
    "scout:demo:workflow:seed": "node --experimental-strip-types scripts/scout-demo-workflow.mjs seed",
    "scout:demo:workflow:reset": "node scripts/scout-demo-reset.mjs",
    "scout:company-outreach:migrate:local": "node scripts/scout-company-outreach-migrate.mjs",
    "scout:release:rehearsal": "npm run build && node --test tests/release-rehearsal.test.mjs",
    "ready": "node scripts/scout-ready.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.29",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.16",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
