{
  "manifest_version": 3,
  "name": "Scout Safe Fill",
  "version": "0.1.0",
  "description": "Fills only user-approved, verified application fields and stops on sensitive questions.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://boards.greenhouse.io/*", "https://jobs.lever.co/*", "https://jobs.ashbyhq.com/*"],
  "action": { "default_popup": "popup.html", "default_title": "Scout Safe Fill" },
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [{
    "matches": ["https://boards.greenhouse.io/*", "https://jobs.lever.co/*", "https://jobs.ashbyhq.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}
