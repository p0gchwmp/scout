{
  "manifest_version": 3,
  "name": "Scout Safe Fill",
  "version": "0.2.0",
  "description": "Fills only user-approved, verified application fields and stops on sensitive questions.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://boards.greenhouse.io/*",
    "https://job-boards.greenhouse.io/*",
    "https://jobs.lever.co/*",
    "https://jobs.ashbyhq.com/*",
    "https://*.myworkdayjobs.com/*",
    "https://*.myworkdaysite.com/*",
    "https://*.bamboohr.com/*",
    "https://www.linkedin.com/jobs/*",
    "https://internshala.com/*",
    "https://tally.so/*",
    "https://docs.google.com/forms/*",
    "https://forms.gle/*",
    "https://*.typeform.com/*",
    "https://*.fillout.com/*",
    "https://*.jotform.com/*",
    "https://forms.office.com/*",
    "https://*.indeed.com/*",
    "https://*.indeed.co.in/*",
    "https://*.naukri.com/*",
    "https://wellfound.com/*",
    "https://unstop.com/*",
    "https://*.cutshort.io/*",
    "https://*.foundit.in/*"
  ],
  "action": { "default_popup": "popup.html", "default_title": "Scout Safe Fill" },
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [{
    "matches": [
      "https://boards.greenhouse.io/*",
      "https://job-boards.greenhouse.io/*",
      "https://jobs.lever.co/*",
      "https://jobs.ashbyhq.com/*",
      "https://*.myworkdayjobs.com/*",
      "https://*.myworkdaysite.com/*",
      "https://*.bamboohr.com/*",
      "https://www.linkedin.com/jobs/*",
      "https://internshala.com/*",
      "https://tally.so/*",
      "https://docs.google.com/forms/*",
      "https://forms.gle/*",
      "https://*.typeform.com/*",
      "https://*.fillout.com/*",
      "https://*.jotform.com/*",
      "https://forms.office.com/*",
      "https://*.indeed.com/*",
      "https://*.indeed.co.in/*",
      "https://*.naukri.com/*",
      "https://wellfound.com/*",
      "https://unstop.com/*",
      "https://*.cutshort.io/*",
      "https://*.foundit.in/*"
    ],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}
